# =============================================================================
# PulseDB Backend - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment.
# Variables marked [REQUIRED] must be set for production use.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=backend
APP_DISPLAY_NAME=PulseDB
APP_VERSION=0.1.0
DEBUG=false
# ENVIRONMENT options: local, development, test, production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true
# CORS_ORIGINS: JSON array format
CORS_ORIGINS=["http://localhost:5176"]
CORS_CREDENTIALS=true
CORS_METHODS=["*"]
CORS_HEADERS=["*"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL (recommended):
DATABASE_URL=postgresql+asyncpg://backend:changeme@localhost:5432/pulse_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# PostgreSQL connection (for Docker Compose)
POSTGRES_DB=pulse_db
POSTGRES_USER=backend
POSTGRES_PASSWORD=changeme

# Redis connection (for Docker Compose)
REDIS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Security & Authentication [REQUIRED for production]
# -----------------------------------------------------------------------------
# [REQUIRED] Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24

# Super Admin Configuration
# Email address of the super admin user (owner) - cannot be deleted or demoted
SUPERADMIN_EMAIL=
# Protected user email - this user cannot be deleted
PROTECTED_USER_EMAIL=

# [REQUIRED for monitoring] Encrypts monitored-instance credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_HOUR=1000
AUTH_REGISTER_RATE_LIMIT=5/minute
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REFRESH_RATE_LIMIT=20/minute
AUTH_PASSWORD_CHANGE_RATE_LIMIT=3/minute

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(name)s | %(levelname)s | %(message)s
# LOG_FILE=./logs/app.log  # Optional: log to file

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
# SENTRY_RELEASE=

# -----------------------------------------------------------------------------
# Google reCAPTCHA v3 (Optional)
# -----------------------------------------------------------------------------
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# -----------------------------------------------------------------------------
# OAuth Authentication (Google)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# OAuth Authentication (Facebook)
# -----------------------------------------------------------------------------
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# OAuth Login — GitHub (callback: /auth/callback/github — same pattern as Google/Facebook)
# -----------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://pulse-db.dev-made.it/auth/callback/github

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
EMAIL_ENABLED=true
# EMAIL_ADAPTER options: file (development), smtp (production)
EMAIL_ADAPTER=file
EMAIL_FILE_PATH=./emails
EMAIL_ENABLE_AUDIT=true

# SMTP Configuration (for production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# EMAIL_ENABLE_RETRY=false
# EMAIL_MAX_RETRIES=5

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Public frontend origin (emails, WebAuthn, health/details frontend check).
# On VPS with Caddy: use the public site URL, not localhost.
FRONTEND_URL=https://pulse-db.dev-made.it

# Bearer token for GET /api/health/details (PulseDB self-monitoring contract)
# HEALTH_DETAILS_TOKEN=generate-a-long-random-secret

# -----------------------------------------------------------------------------
# Monitoring Runtime Configuration
# -----------------------------------------------------------------------------
MONITOR_CHECK_INTERVAL_SECONDS=10
MONITOR_LIVE_POLL_INTERVAL_SECONDS=30
MONITOR_LIVE_MODE_TTL_SECONDS=60
MONITOR_UI_BACKGROUND_REFETCH_SECONDS=300
MONITOR_UI_ACTIVE_REFETCH_SECONDS=120
MONITOR_HEARTBEAT_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# Docker Compose Variables (optional overrides)
# -----------------------------------------------------------------------------
PROJECT_NAME=pulse-db
APP_PORT=8000
